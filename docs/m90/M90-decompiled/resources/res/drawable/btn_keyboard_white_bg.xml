                android:color="@color/c_2c2c2c"/>
            <corners android:radius="4dp"/>
            <solid android:color="@color/c_414141"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <stroke
                android:width="1px"
                android:color="@color/c_2c2c2c"/>
            <corners android:radius="4dp"/>
            <solid android:color="@color/c_414141"/>
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="1px"
                android:color="@color/c_2c2c2c"/>
            <corners android:radius="4dp"/>
            <solid android:color="@color/c_ffffff"/>
        </shape>
    </item>
</selector>
