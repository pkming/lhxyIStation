<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/c_ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rlConfirm"
        android:background="@color/c_ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/c_000000"
            android:id="@+id/tvWheelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/c_000000"
            android:gravity="center"
            android:id="@+id/tvConfirm"
            android:background="@drawable/btn_confirm_bg"
            android:layout_width="@dimen/d_100"
            android:layout_height="@dimen/d_52"
            android:layout_marginTop="@dimen/d_6"
            android:layout_marginRight="@dimen/d_20"
            android:layout_marginBottom="@dimen/d_6"
            android:text="@string/confirm"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/vWheelLins"
        android:background="@color/c_8a8a8a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/d_1"
        android:layout_below="@+id/rlConfirm"/>
    <com.aigestudio.wheelpicker.WheelPicker
        android:id="@+id/wPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vWheelLins"
        app:wheel_atmospheric="true"
        app:wheel_curved="false"
        app:wheel_cyclic="false"
        app:wheel_item_text_color="@color/c_515151"
        app:wheel_item_text_size="28sp"
        app:wheel_selected_item_text_color="@color/c_000000"/>
</RelativeLayout>
