<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/txt_main_datatime"
    android:layout_width="match_parent"
    android:layout_height="@dimen/d_80">
    <ImageView
        android:id="@+id/imageInformation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/d_8"
        android:src="@drawable/information"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="35sp"
        android:textStyle="bold"
        android:textColor="@color/c_ffffff"
        android:id="@+id/tvInformation"
        android:layout_width="@dimen/d_500"
        android:layout_height="@dimen/d_50"
        android:layout_marginLeft="@dimen/d_50"
        android:layout_marginTop="@dimen/d_17"/>
    <LinearLayout
        android:id="@+id/lyToolbarRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/d_20"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/c_ffffff"
            android:id="@+id/tvCMS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/d_5"
            android:layout_marginRight="@dimen/d_5"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/c_ffffff"
            android:id="@+id/tv4G"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/d_5"
            android:layout_marginRight="@dimen/d_5"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/c_ffffff"
            android:id="@+id/tvLocationGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/d_5"
            android:layout_marginRight="@dimen/d_5"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/c_ffffff"
            android:id="@+id/tvLanState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/d_5"
            android:layout_marginRight="@dimen/d_5"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/c_ffffff"
            android:id="@+id/tvWifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/d_5"
            android:layout_marginRight="@dimen/d_5"/>
    </LinearLayout>
</RelativeLayout>
