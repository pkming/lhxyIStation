<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/d_40"
    android:layout_marginRight="@dimen/d_40">
    <TextView
        android:textSize="24sp"
        android:textColor="@color/c_000000"
        android:gravity="center"
        android:id="@+id/tvTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/d_22"
        android:layout_marginTop="@dimen/d_30"
        android:layout_marginRight="@dimen/d_22"/>
    <View
        android:background="@color/c_000000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/d_1px"
        android:layout_marginTop="@dimen/d_30"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/d_50"
        android:layout_marginLeft="@dimen/d_16"
        android:layout_marginRight="@dimen/d_16">
        <Button
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/c_0077ff"
            android:id="@+id/butCancel"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:layout_weight="1"/>
        <View
            android:background="@color/c_000000"
            android:layout_width="@dimen/d_1px"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/c_0077ff"
            android:id="@+id/butOk"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="@dimen/d_50"
            android:text="@string/confirm"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
