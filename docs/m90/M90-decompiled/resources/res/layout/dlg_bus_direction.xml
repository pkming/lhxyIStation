<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/d_10"
    android:layout_marginRight="@dimen/d_10">
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/c_000000"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/d_16"
        android:text="@string/collection_select_direction"/>
    <RadioGroup
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/rgDirection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/d_30">
        <RadioButton
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/c_000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/rbDirectionUpstream"
            android:layout_width="@dimen/d_120"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/d_40"
            android:checked="true"
            android:text="@string/collection_direction_upstream"/>
        <RadioButton
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/c_000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/rbDirectionDown"
            android:layout_width="@dimen/d_120"
            android:layout_height="wrap_content"
            android:text="@string/collection_direction_down"/>
    </RadioGroup>
    <View
        android:background="@color/c_000000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/d_1px"
        android:layout_marginTop="@dimen/d_30"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/d_50"
        android:layout_marginLeft="@dimen/d_16"
        android:layout_marginRight="@dimen/d_16">
        <Button
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/c_0077ff"
            android:id="@+id/butCancel"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:layout_weight="1"/>
        <View
            android:background="@color/c_000000"
            android:layout_width="@dimen/d_1px"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/c_0077ff"
            android:id="@+id/butOk"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="@dimen/d_50"
            android:text="@string/confirm"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
