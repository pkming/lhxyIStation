<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/lyLoginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/toolbar"/>
    <View
        android:background="@color/c_ffffff"
        android:layout_width="match_parent"
        android:layout_height="@dimen/d_1"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rlLoginRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/lyUserName"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/d_32"
            android:layout_marginRight="@dimen/d_32">
            <ImageView
                android:background="@mipmap/icon_user"
                android:layout_width="@dimen/d_20"
                android:layout_height="@dimen/d_20"
                android:contentDescription="@string/login_user"/>
            <com.rengwuxian.materialedittext.MaterialEditText
                android:textSize="24sp"
                android:textColor="@color/c_ffffff"
                android:id="@+id/etUserName"
                android:paddingLeft="@dimen/d_4"
                android:paddingRight="@dimen/d_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/d_4"
                android:text="@string/login_user_txt"
                android:hint="@string/login_user_hint"
                android:maxLength="11"
                app:met_baseColor="@color/c_808080"
                app:met_clearButton="true"
                app:met_floatingLabel="highlight"
                app:met_floatingLabelTextSize="20sp"
                app:met_primaryColor="?attr/colorControlActivated"
                app:met_singleLineEllipsis="true"
                app:met_underlineColor="?attr/colorControlActivated"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/lyUserPwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/d_32"
            android:layout_marginTop="@dimen/d_10"
            android:layout_marginRight="@dimen/d_32"
            android:layout_below="@+id/lyUserName">
            <ImageView
                android:background="@mipmap/icon_pwd"
                android:layout_width="@dimen/d_20"
                android:layout_height="@dimen/d_20"
                android:contentDescription="@string/login_pwd"/>
            <com.rengwuxian.materialedittext.MaterialEditText
                android:textSize="24sp"
                android:textColor="@color/c_ffffff"
                android:id="@+id/etUserPwd"
                android:paddingLeft="@dimen/d_4"
                android:paddingRight="@dimen/d_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/d_4"
                android:hint="@string/login_pwd_hint"
                android:inputType="numberPassword"
                app:met_baseColor="@color/c_808080"
                app:met_clearButton="true"
                app:met_floatingLabel="highlight"
                app:met_floatingLabelTextSize="20sp"
                app:met_primaryColor="?attr/colorControlActivated"
                app:met_singleLineEllipsis="true"
                app:met_underlineColor="?attr/colorControlActivated"/>
        </LinearLayout>
        <Button
            android:textSize="24sp"
            android:textColor="@color/c_000000"
            android:id="@+id/butLogin"
            android:background="@drawable/btn_login_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/d_32"
            android:layout_marginTop="@dimen/d_50"
            android:layout_marginRight="@dimen/d_32"
            android:text="@string/login_but_name"
            android:layout_below="@+id/lyUserPwd"/>
    </RelativeLayout>
</LinearLayout>
